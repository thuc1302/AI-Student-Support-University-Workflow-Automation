<%- include("partials/head", { title: "Đăng nhập - VKU Care" }) %>

<main class="auth-page">
  <section class="auth-card">
    <div class="auth-brand-row">
      <a href="/login" class="vku-logo auth-vku-logo">VKU</a>
    </div>

    <div class="auth-heading">
      <span class="eyebrow">WELCOME BACK</span>
      <h1>Đăng nhập</h1>
    </div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>

    <form method="POST" action="/login" class="auth-form">
      <label>Email</label>
      <input name="email" type="email" required placeholder="student@vku.edu.vn" autocomplete="email">

      <label>Mật khẩu</label>
      <input name="password" type="password" required placeholder="Nhập mật khẩu" autocomplete="current-password">

      <button class="primary full auth-submit">Đăng nhập <span>→</span></button>
    </form>

    <p class="center auth-switch">Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
  </section>
</main>

<%- include("partials/foot") %>
